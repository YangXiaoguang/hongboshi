# OAuth portal integration. Required only when replacing the mock login flow.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Google Maps proxy integration. Required only if MapView is used.
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Optional analytics integration.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Development-only backoffice password login. Disabled by default in production
# unless explicitly enabled. Leave HONGBOSHI_DEV_ADMIN_ACCOUNTS empty to use the
# built-in local accounts documented in README.
HONGBOSHI_ENABLE_DEV_ADMIN_LOGIN=
HONGBOSHI_DEV_ADMIN_ACCOUNTS=

# Local development persistence for course access state.
HONGBOSHI_COURSE_ACCESS_STORE=file
HONGBOSHI_COURSE_ACCESS_FILE=.hongboshi-data/course-access.json

# Local development persistence for course product publish state and audit trail.
HONGBOSHI_COURSE_PRODUCT_STORE=file
HONGBOSHI_COURSE_PRODUCT_FILE=.hongboshi-data/course-products.json
HONGBOSHI_COURSE_PRODUCT_CONTENT_STORE=file
HONGBOSHI_COURSE_PRODUCT_CONTENT_FILE=.hongboshi-data/course-product-content.json
HONGBOSHI_COURSE_PRODUCT_ASSET_STORE=file
HONGBOSHI_COURSE_PRODUCT_ASSET_FILE=.hongboshi-data/course-product-assets.json
HONGBOSHI_COURSE_PRODUCT_ASSET_FILE_STORAGE=local
HONGBOSHI_COURSE_PRODUCT_ASSET_FILE_ROOT=.hongboshi-data/course-product-assets/files
HONGBOSHI_COURSE_PRODUCT_ASSET_OBJECT_PROVIDER=local
HONGBOSHI_COURSE_PRODUCT_ASSET_OBJECT_BUCKET=
HONGBOSHI_COURSE_PRODUCT_ASSET_OBJECT_REGION=
HONGBOSHI_COURSE_PRODUCT_ASSET_OBJECT_PUBLIC_BASE_URL=
HONGBOSHI_COURSE_PRODUCT_ASSET_OBJECT_SIGNING_SECRET=
HONGBOSHI_COURSE_PRODUCT_ASSET_SIGNED_URL_TTL_SECONDS=600

# Local development persistence for transaction work orders and audit trail.
HONGBOSHI_TRANSACTION_OPERATION_STORE=file
HONGBOSHI_TRANSACTION_OPERATION_FILE=.hongboshi-data/transaction-operations.json
HONGBOSHI_TRANSACTION_REFUND_PROVIDER=manual

# Local development persistence for finance accounting-period and fee rules.
HONGBOSHI_FINANCE_RULE_STORE=file
HONGBOSHI_FINANCE_RULE_FILE=.hongboshi-data/finance-rules.json

# Local development persistence for risk review records, SOP templates and queue.
HONGBOSHI_RISK_REVIEW_STORE=file
HONGBOSHI_RISK_REVIEW_FILE=.hongboshi-data/risk-reviews.json
HONGBOSHI_RISK_SOP_STORE=file
HONGBOSHI_RISK_SOP_FILE=.hongboshi-data/risk-sop.json

# Local development persistence for counselor admin profile overlay.
HONGBOSHI_COUNSELOR_PROFILE_STORE=file
HONGBOSHI_COUNSELOR_PROFILE_FILE=.hongboshi-data/counselor-profiles.json

# PostgreSQL persistence. Optional until database-backed stores are enabled.
DATABASE_URL=
DATABASE_POOL_MAX=5
HONGBOSHI_AUTH_SESSION_STORE=memory
HONGBOSHI_RISK_EVENT_STORE=memory
HONGBOSHI_ASSESSMENT_RESULT_STORE=memory
HONGBOSHI_COUNSELING_APPOINTMENT_STORE=memory
HONGBOSHI_COUNSELING_OPERATION_STORE=memory
HONGBOSHI_PAYMENT_WEBHOOK_STORE=memory
HONGBOSHI_AUDIT_ARCHIVE_STORE=memory
